{
  "name": "garepas-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run scripts:build && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env.local src/db/dev/seed.ts",
    "test:units": "tsx src/lib/units.test.ts && tsx src/lib/costos.test.ts && tsx src/lib/produccion-gastos.test.ts && tsx src/lib/analitica.test.ts && tsx src/lib/motor-alertas.test.ts",
    "typecheck": "tsc --noEmit",
    "db:carta-real": "tsx --env-file=.env.local src/db/dev/cargar-carta-real.ts",
    "db:demo": "tsx --env-file=.env.local src/db/dev/demo-datos.ts",
    "db:carta-publica": "tsx --env-file=.env.local src/db/dev/carta-publica.ts",
    "db:migrate:prod": "node scripts/migrar.mjs",
    "db:admin": "node scripts/admin.mjs",
    "db:clasificar-carta": "node scripts/clasificar-carta.mjs",
    "scripts:build": "esbuild scripts/migrar.mjs scripts/admin.mjs scripts/clasificar-carta.mjs --bundle --platform=node --format=esm --outdir=scripts/dist --out-extension:.js=.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.18",
    "lucide-react": "^1.77.0",
    "motion": "^12.43.0",
    "next": "16.4.6",
    "ogl": "^1.0.11",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
