# ---------- Producción (Railway) ----------
# Cadena de conexión del Postgres de Railway (la misma base del sistema anterior).
DATABASE_URL=postgres://usuario:clave@host:5432/base
# Mínimo 32 caracteres. Genera uno con: openssl rand -base64 48
AUTH_SECRET=cambia-esto-por-un-secreto-largo-de-32-o-mas
# El número de pedidos está en src/app/menu/page.tsx (TELEFONO / WA).

# ---------- Solo desarrollo ----------
# Usuarios de la semilla local
ADMIN_PASSWORD=admin123
CAJERO_PASSWORD=cajero123
