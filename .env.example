# Postgres: en local el mismo que usa el backend Spring (o una copia).
DATABASE_URL=postgres://usuario:clave@localhost:5432/garepas
# Mínimo 32 caracteres. Genera uno con: openssl rand -base64 48
AUTH_SECRET=cambia-esto-por-un-secreto-largo-de-32-o-mas
# Opcional: si no existe, los botones de WhatsApp no se muestran.
NEXT_PUBLIC_WHATSAPP_URL=
# Semilla (solo desarrollo)
ADMIN_PASSWORD=admin123
CAJERO_PASSWORD=cajero123
